# APK distribuído: use a API pública da hospedagem com HTTPS.
# EXPO_PUBLIC_API_URL=https://testes-techcode.shop/app_mamografia/api/index.php
# Desenvolvimento em aparelho físico: o IP do PC funciona apenas na mesma rede.

# ID do aplicativo Android no AdMob (usado ao gerar o app).
# Sem esta variável, a configuração usa o aplicativo de teste oficial do Google.
# ADMOB_ANDROID_APP_ID=ca-app-pub-0000000000000000~0000000000
